{
  "name": "MacPaint",
  "short_name": "MacPaint",
  "description": "Editor de dibujo 1-bit inspirado en el MacPaint de 1984, con patrones de dither.",
  "id": "./macpaint.html",
  "start_url": "./macpaint.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "lang": "es",
  "categories": ["graphics", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "./macpaint.html",
      "accept": { "image/*": [".png", ".jpg", ".jpeg", ".gif", ".webp", ".bmp"] }
    }
  ]
}
